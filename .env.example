# Ping Tool Configuration
# Copy this file to .env and update with your settings

# Required: The URL to ping
URL_TO_PING=https://your-app.onrender.com

# Optional: Ping interval in milliseconds (default: 60000 = 1 minute)
PING_INTERVAL=60000

# Optional: Request timeout in milliseconds (default: 5000 = 5 seconds)
TIMEOUT=5000
